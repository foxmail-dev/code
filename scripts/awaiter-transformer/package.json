{
  "name": "awaiter-transformer",
  "version": "1.0.0",
  "description": "Transform TypeScript __awaiter/__generator compiled output to native async/await",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli.ts",
    "test": "jest",
    "transform": "ts-node src/cli.ts transform",
    "transform:file": "ts-node src/cli.ts transform-file"
  },
  "dependencies": {
    "ts-morph": "^21.0.0",
    "typescript": "^5.3.0",
    "commander": "^12.0.0",
    "glob": "^10.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0"
  }
}